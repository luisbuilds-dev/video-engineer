{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash|Write|Edit",
        "hooks": [{ "type": "command", "command": "node .claude/hooks/proteger.mjs" }]
      }
    ]
  },
  "permissions": {
    "allow": [
      "Bash(npm run doctor)",
      "Bash(npm run instalar)",
      "Bash(npm run transcribir *)",
      "Bash(npm run cortar *)",
      "Bash(npm run analizar *)",
      "Bash(npm run componer *)",
      "Bash(npm run render *)",
      "Bash(npm run aprender *)",
      "Bash(npm run consejos *)",
      "Bash(npm run revisar *)",
      "Bash(npm test)"
    ]
  }
}
